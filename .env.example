# Bu dosyayı .env adıyla kopyalayın ve doldurun. .env asla GitHub'a gönderilmez.

# Oturum çerezlerini imzalamak için uzun, rastgele bir metin
# (üretmek için: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# --- Giriş şifresi ---
# İnternete açarken MUTLAKA doldurun (yoksa adresi bulan herkes API kotanızı harcar).
# Bilgisayarınızda denerken boş bırakabilirsiniz.
APP_SIFRESI=

# --- Google Places API (New) — gerçek veri için zorunlu ---
# Boş bırakılırsa uygulama demo verisiyle çalışır.
GOOGLE_PLACES_API_KEY=

# --- Harita (isteğe bağlı) ---
# Maps JavaScript API için ayrı, HTTP referrer kısıtlı bir anahtar.
GOOGLE_MAPS_JS_KEY=
GOOGLE_MAP_ID=DEMO_MAP_ID

# --- Claude (isteğe bağlı ama önerilir) ---
# Yorum özetleri ve menü fotoğraflarını okumak için. Boşsa kural tabanlı analiz kullanılır.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- SerpApi (isteğe bağlı) ---
# "Derin analiz": 30 güncel yorum + tarihli menü fotoğrafları.
SERPAPI_API_KEY=

# --- Fatura güvenliği ---
# Uygulama Google'a günde bundan fazla istek göndermez (sayaç gece yarısı sıfırlanır).
# Bir şehir taraması 4-8 arama isteği harcar; her gösterilen fotoğraf 1 foto isteği.
GUNLUK_ARAMA_LIMITI=200
GUNLUK_FOTO_LIMITI=300

# --- Sunucu ---
# PythonAnywhere'de 0 yapın (thread desteklemiyor; işler istek içinde çalışır,
# Claude analizi her mekan ilk açıldığında yapılır)
ARKA_PLAN_ISLERI=1
# Tarama sırasında tüm mekanları Claude ile analiz et (boşsa ARKA_PLAN_ISLERI ile aynı)
CLAUDE_TOPLU_ANALIZ=
# HTTPS üzerinden yayındaysanız 1 yapın (çerezler sadece güvenli bağlantıda gönderilir)
HTTPS=0

# --- Ayarlar ---
# Google anahtarı olsa bile demo verisiyle denemek için 1 yapın
DEMO_MODU=
VARSAYILAN_HEDEF=50
# Şehir taranırken en iyi kaç mekanın fotoğraflarında menü aransın (Claude gerekir)
MENU_TARAMA_LIMITI=8
# Şehir taranırken en iyi kaç mekana otomatik derin analiz yapılsın (SerpApi kotası harcar)
DERIN_ANALIZ_LIMITI=0
DERIN_YORUM_ADEDI=30
# Bir şehir kaç gün sonra yeniden taranabilir
YENILEME_GUN=30
# Google fotoğraf adresleri kaç saat önbellekte tutulsun
FOTO_URI_SAAT=24
# Veritabanı dosyası (boşsa instance/pusula.sqlite3)
VERITABANI=
